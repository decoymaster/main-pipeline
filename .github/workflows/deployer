name:deployer

on:
  workflow_dispatch:
    inputs:
      approval_word:
        description: "Type 'approve' to authorize local environment rollout"
        required: true
        type: string
      image_tag:
        description: "Which image tag do you want to deploy? (main or branch-A)"
        required: true
        default: "main"

jobs:
  validate-and-deploy:
    runs-on: self-hosted
    steps:
      - name: Verify Approval Input
        run: |
          if [ "${{ github.event.inputs.approval_word }}" != "approve" ]; then
            echo " Aborting: Invalid approval token provided."
            exit 1
          fi

      - name: Update Application Container (Zero-Downtime Design)
        run: |
          # 1. Pull the requested image tag safely
          docker pull ghcr.io/${{ github.repository }}/testing-pipe-web:${{ github.event.inputs.image_tag }}
          
          # 2. Stop and clear out the old container instance
          docker rm -f pipeline-web-live || true
          
          # 3. Spin up the new chosen container
          docker run -d -p 8080:80 --name pipeline-web-live ghcr.io/${{ github.repository }}/testing-pipe-web:${{ github.event.inputs.image_tag }}
          
          # 4. Wipe out dead dangling layers
          docker image prune -f
